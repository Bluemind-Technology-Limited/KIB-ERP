# Backend API base URL (dev default: http://localhost:3002/api)
VITE_API_URL=http://localhost:3002

# Supabase (Auth + Realtime) — from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare R2 — direct browser uploads (values are embedded in the bundle)
VITE_R2_ACCOUNT_ID=your-cloudflare-account-id
VITE_R2_ACCESS_KEY_ID=your-r2-access-key-id
VITE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
VITE_R2_BUCKET_NAME=kib-qa
VITE_R2_PUBLIC_BASE_URL=https://pub-YOUR-BUCKET-ID.r2.dev
# Optional: override the S3 endpoint
# VITE_R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
